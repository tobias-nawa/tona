# Lint for engine and installer. Run on changed lines (just lint) with the ROCm toolchain's clang-tidy, which
# parses HIP. Nesting depth lives here because lizard miscounts it for C++ (tools/gates/functions.py).
# Families: bugprone, clang-analyzer, performance, cert, misc and chosen modernize and readability checks. The chosen
# ones are those that found real defects or dead weight when the whole tree was measured (2026-11-25, ROCm clang-tidy
# 24, unique findings per check); the others are listed below with their counts and left out, no file has an exception.
# Left out on purpose:
#   bugprone: signed-bitwise and narrowing (quant and bit-packing code is built on them), random seeds (tests are seeded
#     on purpose), int-to-ptr (device pointers), enum size, dynamic static init (false positives on __constant__ tables
#     in HIP headers), easily-swappable-parameters.
#   cert: err33-c (500: results of printf and snprintf in diagnostics), dcl59-cpp (63: constants in anonymous namespaces
#     of headers), msc32-c and msc51-cpp (40: seeded generators, as above), dcl16-c (alias of the literal suffix check).
#   misc: non-private-member-variables-in-classes (500: structs with public data are the style here), include-cleaner
#     (3400: include-what-you-use discipline), const-correctness (850), use-anonymous-namespace (66), no-recursion (7:
#     the parsers recurse on purpose), multiple-inheritance, anonymous-namespace-in-header (63, the same as cert-dcl59-cpp),
#     use-internal-linkage (18: kernels and test helpers of .hip files, whose names scripts/isa-diff.py compares),
#     confusable-identifiers (3: b1 and bl, q1 and ql, paper notation), definitions-in-headers (2: test rigs that one
#     translation unit includes), redundant-expression (9: all are `x != x` NaN tests; the build has no -ffast-math).
#   modernize: avoid-c-style-cast (3300: the code base casts C-style), avoid-c-arrays (660), use-trailing-return-type,
#     use-nodiscard (475), use-std-print (580), use-designated-initializers (1500), use-auto (370), use-ranges (136),
#     use-integer-sign-comparison (135), use-scoped-lock (57), loop-convert (18), use-string-view (15), macro-to-enum
#     (20), use-std-numbers (its fix turned the split constant kLn2Hi into the full ln 2, which would change results),
#     use-default-member-init (its fix of a member that the constructor initializes from arguments did not compile).
#   readability: math-missing-parentheses (2000), isolate-declaration (1000), uppercase-literal-suffix (665),
#     static-accessed-through-instance (420), trailing-comma (340), named-parameter (77), avoid-nested-conditional-operator
#     (80), avoid-return-with-void-value (72), use-concise-preprocessor-directives (25), inconsistent-ifelse-braces (18),
#     simplify-boolean-expr (33: every hit is a test macro, EXPECT(a && b) expands to !(a && b); its fixes of device
#     conditions also changed kernels in scripts/isa-diff.py), use-std-min-max (the same, one device site),
#     redundant-string-init (the key placeholders of engine/update/keys.h stay `= ""` for the release edit),
#     convert-member-functions-to-static (19), use-anyofallof (12), redundant-member-init (its fix removed `{}` that keeps
#     designated initializers free of -Wmissing-field-initializers), non-const-parameter (its fix made atomic
#     flag pointers const), inconsistent-declaration-parameter-name (its fix renamed header parameters to the shorter name
#     of the definition), identifier-naming, magic-numbers, braces-around-statements, implicit-bool-conversion.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-signed-bitwise,
  -bugprone-narrowing-conversions,
  -bugprone-random-generator-seed,
  -bugprone-dynamic-static-initializers,
  cert-*,
  -cert-err33-c,
  -cert-dcl59-cpp,
  -cert-msc32-c,
  -cert-msc51-cpp,
  -cert-dcl16-c,
  clang-analyzer-*,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-const-correctness,
  -misc-use-anonymous-namespace,
  -misc-no-recursion,
  -misc-multiple-inheritance,
  -misc-anonymous-namespace-in-header,
  -misc-use-internal-linkage,
  -misc-confusable-identifiers,
  -misc-definitions-in-headers,
  -misc-redundant-expression,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-equals-delete,
  modernize-use-emplace,
  modernize-use-starts-ends-with,
  modernize-use-using,
  modernize-deprecated-headers,
  modernize-raw-string-literal,
  modernize-pass-by-value,
  
  performance-*,
  -performance-no-int-to-ptr,
  -performance-enum-size,
  readability-function-size,
  readability-function-cognitive-complexity,
  readability-container-contains,
  readability-container-size-empty,
  readability-redundant-qualified-alias,
  
  readability-redundant-casting,
  readability-redundant-nested-if,
  readability-else-after-return,
  readability-trivial-switch,
  readability-container-data-pointer,
  readability-ambiguous-smartptr-reset-call,
  readability-make-member-function-const,
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(engine|installer|bench)/.*'
ExcludeHeaderFilterRegex: '.*/third_party/.*'
CheckOptions:
  readability-function-size.NestingThreshold: 5
  readability-function-size.LineThreshold: 80
  readability-function-size.ParameterThreshold: 6
  readability-function-cognitive-complexity.Threshold: 25
