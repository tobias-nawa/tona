# Direct dependency of the code gates; requirements.txt is generated from this file (pip-tools 7.6.2, Python 3.14):
#   pip-compile --generate-hashes --allow-unsafe --strip-extras --output-file=tools/gates/requirements.txt tools/gates/requirements.in
