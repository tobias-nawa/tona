+// Weights of the first unit of this wave in every int8 task of the phase go into L2 before x is staged: the staging
+// waits for a read of x from device memory (and a barrier), and the first weight reads of the units would start only
+// after it. Same unit numbering as run_phase; the prefetch changes no value.
+__device__ __noinline__ void prefetch_first_units(const PhaseRange pr, const WaveCtx wc, const Batch& bt) {
+    int64_t base = 0;
+    for (int i = pr.a; i < pr.b; i++) {
+        DevTask t = pr.tasks[i];
+        const bool tw = bt.wide && t.wide;
+        if (tw) t.units = (t.rows + 15) / 16;
+        if (bt.n_u >= 0 || bt.wide) {
+            if (bt.n_u >= 0 && t.n_exp > 1) t.units = (int64_t)t.upe * min(t.n_exp, bt.n_u);
+            t.base = base;
+            base += t.units;
+        }
+        if (tw || !t.xq || t.n_exp <= 1) continue;  // expert groups only: the dense tasks are a few KB each
+        const int64_t r = (int64_t)(((uint32_t)wc.w + (uint32_t)wc.W - (uint32_t)(t.base % wc.W)) % (uint32_t)wc.W);
+        if (r >= t.units) continue;
+        uint32_t mask;
+        const int64_t u = resolve_unit(t, r, bt, mask);
+        if (mask == 0) continue;
+        const uint8_t* p = t.w + u * (WAVE / t.L) * t.row_bytes;
+        __builtin_amdgcn_s_prefetch_data(p, 31);
+    }
+}
