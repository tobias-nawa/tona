  "release_date": "2025-10",
  "lineage": {
    "family": "Qwen3-VL"
  },
  "purpose": "General vision-language model: stronger text, visual perception and reasoning, long context and video, spatial perception and agent interaction; OCR in 32 languages. A Thinking edition exists separately.",
  "tasks": [
    "vision",
    "documents",
    "general"
  ],
  "modalities": {
    "input": [
      "text",
      "image",
      "video"
    ],
    "output": [
      "text"
    ]
  },
  "languages": {
    "natural": [
      "many"
    ]
  },
  "license": {
    "name": "Apache-2.0",
    "verified": true,
    "commercial_use": "yes",
    "redistribution": "yes",
    "notes": "HF repo has no LICENSE file; card tag apache-2.0 and the QwenLM/Qwen3-VL GitHub LICENSE read is the unmodified Apache-2.0 text"
  },
  "architecture": {
    "kind": "MoE vision-language (qwen3_vl_moe)",
    "gguf_arch": "qwen3vlmoe",
    "params_total_b": 31,
    "params_active_b": 3,
    "context_native": 262144,
    "context_max": 1000000,
    "why_this_design": "Interleaved-MRoPE for time/width/height, DeepStack fusing multi-level ViT features for finer detail, text-timestamp alignment for video (card)."
  },
  "variants": [
    {
