  "soft": {
    "strengths": [
      "only 3B active parameters",
      "32 OCR languages, robust to blur, tilt and low light",
      "can answer questions about a page, not just transcribe"
    ],
    "weaknesses": [
      "scores for this size not read (card tables are images)",
      "bigger than the dedicated parsers",
      "MDPBench (independent): the 8B Instruct scores German 73.7, below the dedicated 1B parsers (GLM-OCR 82.7, PaddleOCR-VL-1.5 84.8) and drops on photographed pages (65.0)"
    ],
    "best_for": [
      "questions about charts, screenshots and pages; mixed-language documents"
    ],
    "maturity": "Qwen is the largest open VL family with frequent updates; Qwen3.5 (inbox) has a vision encoder too"
  },
  "tona_fit": {
    "verdict": "candidate",
    "reason": "general reader for questions about documents and images (DocVQA 95.0, OCRBench 903 vendor), Apache-2.0 verified; 31B total needs 24 GB or expert offload on 16 GB; no third-party German score for this size"
  },
