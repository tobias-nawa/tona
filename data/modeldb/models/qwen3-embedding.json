  },
  "architecture": {
    "kind": "dense decoder transformer used as encoder, last-token pooling",
    "gguf_arch": "qwen3",
    "params_total_b": 8,
    "layers": 36,
    "context_native": 32768,
    "why_this_design": "Built on Qwen3 foundation models to inherit multilingual understanding; instruction-aware so queries carry a task sentence (1-5% retrieval gain per card). MRL output dims 32 to 4096. Sizes 0.6B (28 layers, 1024-d), 4B (2560-d), 8B (4096-d)."
  },
